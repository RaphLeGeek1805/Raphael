# =============================================================================
# Configuration répondeur DEPAN MAGIC — copier en .env et renseigner les valeurs
# =============================================================================
# Architecture : OVH Contact Center Solution (mode expert) gère le menu 1-4
# dans l'UI OVH. Sur la touche 0, OVH transfère l'appel en SIP vers cet
# Asterisk qui exécute l'agent IA Claude.
# =============================================================================

# --- Réseau ---
# IP publique fixe (ou DDNS) du serveur où tourne Asterisk.
# Doit être joignable par les plages IP du CCS OVH sur UDP 5060 + RTP 10000-10100.
EXTERNAL_IP=203.0.113.10

# Plages IP autorisées à envoyer du SIP vers cet Asterisk.
# À récupérer dans : Manager OVH → VoIP → ligne 0033184162110 → Configuration
#                    → Contact Center Solution → onglet Sécurité (ou doc OVH).
# Format Asterisk PJSIP "match" : liste séparée par des virgules, /netmask optionnel.
# Exemple :
#   OVH_CCS_ALLOWED_IPS=92.222.144.0/24,213.186.33.0/24,54.36.0.0/16
OVH_CCS_ALLOWED_IPS=

# --- Transfert d'urgence vers le mobile d'astreinte ---
# Quand Claude détecte une urgence, Asterisk envoie un SIP REFER pour
# rediriger l'appel. Deux options de config dans OVH CCS :
#
# (a) Créer dans l'UI OVH une étape "Appel sortant" qui appelle votre mobile
#     d'astreinte, et exposer cette étape via une URI SIP. Mettez ici l'URI :
#         OVH_URGENCE_REFER_URI=sip:urgence@ccs.ovh.fr
#
# (b) Laisser vide : Asterisk diffusera alors un message demandant à
#     l'appelant de rappeler et de taper 1 (route urgence du menu OVH).
OVH_URGENCE_REFER_URI=

# (Optionnel) numéro mobile au format E.164 — utilisé uniquement si vous
# souhaitez ajouter une trunk SIP sortante pour appeler vous-même (futur).
TECH_MOBILE=33600000000

# --- Mot de passe extension SIP interne 100 (softphone de test, non-prod) ---
EXT_100_PASSWORD=changeme

# --- Manager AMI (interface admin local) ---
AMI_PASSWORD=changeme

# =============================================================================
# Conseiller vocal IA (l'appel arrive ici depuis OVH CCS sur la touche 0)
# =============================================================================

# --- Anthropic / Claude ---
# Récupérez une clé sur https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Modèle : claude-opus-4-7 (qualité max).
# Pour réduire latence/coût en prod, basculez sur claude-sonnet-4-6.
CLAUDE_MODEL=claude-opus-4-7

# --- Speech-to-Text (Deepgram, français) ---
DEEPGRAM_API_KEY=changeme

# --- Text-to-Speech (ElevenLabs, voix française) ---
# Si vide, fallback automatique sur gTTS (qualité moindre).
ELEVENLABS_API_KEY=changeme
ELEVENLABS_VOICE_ID=ThT5KcBeYPX3keUQqHPh

# --- Postgres (historique des appels) ---
PG_PASSWORD=changeme
