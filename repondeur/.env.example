# =============================================================================
# Configuration répondeur DEPANMAGIC - copier en .env et renseigner les valeurs
# =============================================================================

# --- Trunk SIP OVH ---
# Identifiants fournis dans l'espace client OVH > Téléphonie > Lignes SIP
OVH_SIP_USERNAME=0033xxxxxxxxx
OVH_SIP_PASSWORD=changeme

# IP publique du serveur où tourne Asterisk (obligatoire si NAT)
EXTERNAL_IP=203.0.113.10

# --- Numéro du technicien d'astreinte (format E.164 sans le +) ---
# Ex : 33612345678 pour +33 6 12 34 56 78
TECH_MOBILE=33600000000

# --- Mot de passe extension SIP interne 100 (softphone) ---
EXT_100_PASSWORD=changeme

# --- Manager AMI (interface admin local) ---
AMI_PASSWORD=changeme

# --- Codes PIN messageries vocales (4 chiffres) ---
VM_PIN_100=1234
VM_PIN_101=1234
VM_PIN_102=1234
VM_PIN_103=1234

# --- Adresses email recevant les messages vocaux ---
VM_EMAIL_ACCUEIL=accueil@depanmagic.fr
VM_EMAIL_DEVIS=devis@depanmagic.fr
VM_EMAIL_SUIVI=suivi@depanmagic.fr
VM_EMAIL_URGENCE=urgences@depanmagic.fr

# --- Relais SMTP pour envoi des emails (ex : SMTP OVH, SendGrid, Mailgun) ---
SMTP_RELAY_HOST=ssl0.ovh.net:587
SMTP_RELAY_USER=repondeur@depanmagic.fr
SMTP_RELAY_PASSWORD=changeme

# =============================================================================
# Conseiller vocal IA (option 0 du menu) — Claude + STT + TTS
# =============================================================================

# --- Anthropic / Claude ---
# Récupérez une clé sur https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
# Modèle conseillé : claude-opus-4-7 (qualité max).
# Pour réduire latence/coût en prod, basculez sur claude-sonnet-4-6.
CLAUDE_MODEL=claude-opus-4-7

# --- Speech-to-Text (Deepgram, français) ---
# https://console.deepgram.com — offre gratuite suffisante pour tester
DEEPGRAM_API_KEY=changeme

# --- Text-to-Speech (ElevenLabs, voix française) ---
# https://elevenlabs.io — voix par défaut "Charlie" (fr) ; choisissez la vôtre
# dans la VoiceLab et copiez son ID ici. Si vide, fallback automatique sur gTTS.
ELEVENLABS_API_KEY=changeme
ELEVENLABS_VOICE_ID=ThT5KcBeYPX3keUQqHPh

# --- Postgres (historique des appels) ---
PG_PASSWORD=changeme
